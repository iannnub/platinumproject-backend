APP_NAME="Platinum Project API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
APP_URL=https://api.platinumproject.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production MySQL Database (Niagahoster / Hostinger)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_platinum
DB_USERNAME=u123456789_admin
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.platinumproject.my.id

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=platinum_cache_

# Sanctum Stateful Domains
SANCTUM_STATEFUL_DOMAINS="platinumproject.my.id,www.platinumproject.my.id"

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS="https://platinumproject.my.id,https://www.platinumproject.my.id"
